{
  "version": 2,
  "cmakeMinimumRequired": {
      "major": 4,
      "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Configure the plug-ins with the Visual Studio 2026 x64 generator.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-win64"
    },
    {
      "name": "macos-universal",
      "displayName": "macOS Universal",
      "description": "Configure the no-GUI plug-in for Apple Silicon and Intel Macs.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-macos",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release plug-ins",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "targets": [
        "LostTech",
        "LostTechNoGUI",
        "wpfunc_tests"
      ]
    },
    {
      "name": "windows-x64-debug-gui",
      "displayName": "Windows x64 Debug GUI plug-in",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "targets": [
        "LostTechDebug"
      ]
    },
    {
      "name": "macos-universal-release",
      "displayName": "macOS Universal Release plug-in",
      "configurePreset": "macos-universal",
      "targets": [
        "LostTechNoGUI",
        "wpfunc_tests"
      ]
    }
  ]
}
